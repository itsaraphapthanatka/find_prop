# คัดลอกเป็น deploy/.env แล้วกรอกค่า (ชุดเดียวกับ Vercel → Settings → Environment Variables)
#   cp deploy/.env.example deploy/.env && nano deploy/.env && chmod 600 deploy/.env
# ⚠️ ห้าม commit / ห้ามส่งไฟล์นี้ให้ใคร · ค่าที่มี $ # หรือช่องว่าง ให้ครอบด้วย '...'

# ── เวอร์ชันที่รันอยู่ (deploy.sh เขียนให้เอง ไม่ต้องกรอก) ──
HOP_TAG=

# ── ทางเข้าเว็บ ──
# พอร์ตในเครื่องที่ Caddy รับ (เฉพาะ 127.0.0.1 ไว้ทดสอบด้วย curl) — บน edgexpert 8080/3000 มีบริการอื่นใช้แล้ว
WEB_PORT=8098
# Cloudflare Tunnel — บน edgexpert ใช้ tunnel เดียวกับเว็บ appreview (คอนเทนเนอร์ `cloudflared`, โหมด host, จัดการจากแดชบอร์ด)
#   Zero Trust → Networks → Tunnels → tunnel ของ appreview → Public Hostname → staging.hopai.online → HTTP → localhost:<WEB_PORT>
#   จึงปล่อยสองบรรทัดล่างว่าง (compose ไม่ต้องรัน cloudflared เอง)
# เครื่องอื่นที่ยังไม่มี tunnel: COMPOSE_PROFILES=tunnel + โทเคนของ tunnel ใหม่ แล้ว Public Hostname ชี้ web:8080
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# ── Supabase ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── โดเมนเว็บ (ลิงก์กลับจาก Stripe + ลิงก์ในอีเมลเชิญ) — ช่วงทดสอบใช้ https://staging.hopai.online ──
PUBLIC_APP_URL=https://hopai.online
INVITE_WEB_BASE=https://hopai.online

# ── Stripe (ค่าเดิมจาก Vercel — ตอนย้ายจริงแค่แก้ URL ของ webhook เดิมใน Stripe ความลับจึงยังเป็นตัวเดิม) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ผู้ช่วย AI (คีย์อยู่ฝั่งเซิร์ฟเวอร์เท่านั้น) ──
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# ── แจ้งเตือน: push-cron ทุกวัน 07:00 เวลาไทย (เซิร์ฟเวอร์ยิงเอง แทน Vercel Cron) ──
CRON_SECRET=
# JSON ทั้งก้อนบรรทัดเดียว ครอบด้วย '...' เช่น FCM_SERVICE_ACCOUNT='{"type":"service_account",...}'
FCM_SERVICE_ACCOUNT=
# ตั้งเป็น 0 เพื่อปิดตัวตั้งเวลาในเครื่อง (เช่น ช่วงทดสอบที่ Vercel ยังยิง cron อยู่ — กันแจ้งเตือนซ้ำ)
ENABLE_CRON=0

# ── อีเมลเชิญลูกทีม (Gmail: App Password 16 ตัวติดกัน ไม่มีเว้นวรรค) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
INVITE_FROM=
RESEND_API_KEY=

# ── วิดีโอสอนใช้งาน (deploy/media-hls.sh เขียนกุญแจให้เอง ไม่ต้องกรอก) ──
# กุญแจถอดรหัส HLS 16 ไบต์ (hex 32 ตัว) — /api/media-key ให้เฉพาะสมาชิกที่ล็อกอิน
MEDIA_HLS_KEY=
# โฟลเดอร์ชิ้นวิดีโอบนเครื่อง (ค่าเริ่ม ~/hop-media)
# HOP_MEDIA_DIR=
